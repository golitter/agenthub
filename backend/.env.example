# Backend 环境变量模板
#
# 使用方法：cp backend/.env.example backend/.env，然后按本机环境填写。
# .env 会被 backend/internal/conf 在启动时自动加载；该文件本身不会入库。
#
# 配置优先级：已导出的 Shell 环境变量 > backend/.env > configs/config.yaml。
# 模板中的空值表示“继承 YAML 配置”，不要为了完整而随意填入默认值。
# 所有密码、Token、MinIO 凭据和 capability 密钥都只放在 .env，不要提交到 Git。

# ═══════════════════════════════════════════════════════════════════════════════
# 1. 服务运行与身份
# ═══════════════════════════════════════════════════════════════════════════════

# 为空时继承 configs/config.yaml。
SERVER_PORT=
AGENTEND_HOST=
AGENTEND_PORT=

# 开启后，Backend 与 AgentEnd 必须分别配置下面两个服务 Token。
AGENTEND_SERVICE_AUTH_ENABLED=
AGENTEND_SERVICE_TOKEN=
BACKEND_SERVICE_TOKEN=

# 生产环境建议显式设置为 true；本地开发可留空，继承 YAML。
API_AUTH_ENABLED=
JWT_SECRET=
JWT_EXPIRE_HOURS=
ADMIN_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════════════
# 2. MySQL / Redis / CORS
# ═══════════════════════════════════════════════════════════════════════════════

MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DBNAME=
MYSQL_CHARSET=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# 多个来源用英文逗号分隔；为空时继承 configs/config.yaml。
CORS_ALLOW_ORIGINS=

# ═══════════════════════════════════════════════════════════════════════════════
# 3. Skill / 共享 MinIO
# ═══════════════════════════════════════════════════════════════════════════════

# MINIO_ACCESS_KEY / MINIO_SECRET_KEY 是共享应用账号：
# - 用于 Skill MinIO；
# - 当 Avatar / Artifact 的专用凭据为空时，作为它们的凭据回退值。
# 三类存储仍必须使用不同 Bucket；Root 凭据不要填入这里。
SKILL_STORAGE_ENABLED=
SKILL_STORAGE_REQUIRE_ADMIN=
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=
MINIO_CA_CERT=

# 常用 Skill 行为覆盖；不需要调整时留空并使用 YAML 默认值。
SKILL_STORAGE_READ_PREFERENCE=
SKILL_STORAGE_SHADOW_WRITE_BLOB=
SKILL_STORAGE_ALLOW_LEGACY_TMP_CONFIRM=

# ═══════════════════════════════════════════════════════════════════════════════
# 4. Avatar 存储
# ═══════════════════════════════════════════════════════════════════════════════

# 默认写入 MinIO。没有 MinIO 时必须显式设置：
# AVATAR_STORAGE_WRITE_PROVIDER=local
# ASSET_MINIO_ENABLED=false
# LOCAL_STORAGE_ENABLED=true
AVATAR_STORAGE_WRITE_PROVIDER=
ASSET_MINIO_ENABLED=
ASSET_MINIO_ENDPOINT=
ASSET_MINIO_BUCKET=

# 留空时复用上面的 MINIO_ACCESS_KEY / MINIO_SECRET_KEY。
ASSET_MINIO_ACCESS_KEY=
ASSET_MINIO_SECRET_KEY=
ASSET_MINIO_USE_SSL=
ASSET_MINIO_CA_CERT=
ASSET_MINIO_REQUEST_TIMEOUT=

LOCAL_STORAGE_ENABLED=
LOCAL_STORAGE_DIR=
LOCAL_STORAGE_URL_PREFIX=

# ═══════════════════════════════════════════════════════════════════════════════
# 5. Builtin Artifact 存储
# ═══════════════════════════════════════════════════════════════════════════════

# 启用 Artifact 时必须同时提供 MinIO 凭据和独立的 capability 密钥。
# ARTIFACT_CAPABILITY_SECRET 至少 32 个字符，只放在本机 .env 或部署 Secret 中。
ARTIFACT_STORAGE_ENABLED=
ARTIFACT_MINIO_ENDPOINT=
ARTIFACT_MINIO_BUCKET=

# 留空时复用上面的 MINIO_ACCESS_KEY / MINIO_SECRET_KEY。
ARTIFACT_MINIO_ACCESS_KEY=
ARTIFACT_MINIO_SECRET_KEY=
ARTIFACT_MINIO_USE_SSL=
ARTIFACT_MINIO_CA_CERT=
ARTIFACT_MINIO_REQUEST_TIMEOUT=

ARTIFACT_MAX_OBJECT_SIZE=
ARTIFACT_MAX_PER_MESSAGE=
ARTIFACT_UPLOAD_TOKEN_TTL=
ARTIFACT_CAPABILITY_SECRET=
ARTIFACT_FAILED_RETENTION=

# 说明：QINIU_* 已不属于当前 Backend 配置，旧的本地 .env 中如仍有这些变量可以删除。
