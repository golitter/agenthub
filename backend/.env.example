# Backend 环境变量示例
# 使用方法：cp backend/.env.example backend/.env，然后填入实际值
#
# 其余配置（MySQL / Redis / JWT / Admin / CORS 等）默认走 backend/configs/config.yaml；
# 下方环境变量会覆盖 YAML 中对应字段。敏感凭据不要提交到 Git。

# ─── Avatar MinIO 对象存储（独立于 Skill MinIO） ───
# MinIO 是头像默认写入目标；切换本地必须显式设置
# AVATAR_STORAGE_WRITE_PROVIDER=local，并同时启用 LOCAL_STORAGE_ENABLED。
AVATAR_STORAGE_WRITE_PROVIDER=minio
ASSET_MINIO_ENABLED=true
ASSET_MINIO_ENDPOINT=127.0.0.1:19000
ASSET_MINIO_BUCKET=agenthub-assets
ASSET_MINIO_ACCESS_KEY=
ASSET_MINIO_SECRET_KEY=
ASSET_MINIO_USE_SSL=false
ASSET_MINIO_CA_CERT=
ASSET_MINIO_REQUEST_TIMEOUT=10s
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_DIR=./uploads
LOCAL_STORAGE_URL_PREFIX=/uploads

# ─── Builtin render Artifact MinIO 对象存储 ───
# 默认关闭。启用后填写独立于 Avatar/Skill 的应用账号与 capability 密钥。
ARTIFACT_STORAGE_ENABLED=false
ARTIFACT_MINIO_ENDPOINT=127.0.0.1:19000
ARTIFACT_MINIO_BUCKET=agenthub-artifacts
ARTIFACT_MINIO_ACCESS_KEY=
ARTIFACT_MINIO_SECRET_KEY=
ARTIFACT_MINIO_USE_SSL=false
ARTIFACT_MINIO_CA_CERT=
ARTIFACT_MINIO_REQUEST_TIMEOUT=15s
ARTIFACT_MAX_OBJECT_SIZE=25MiB
ARTIFACT_MAX_PER_MESSAGE=20
ARTIFACT_UPLOAD_TOKEN_TTL=30m
ARTIFACT_FAILED_RETENTION=24h
ARTIFACT_CAPABILITY_SECRET=

# ─── Skill MinIO 对象存储（本地宿主机运行 Backend） ───
# 默认关闭。启用前请确认 MinIO API 地址、Bucket 和应用账号可用。
# 本地 MinIO 若通过 19000 暴露 API，可使用：
#   SKILL_STORAGE_ENABLED=true
#   MINIO_ENDPOINT=127.0.0.1:19000
#   MINIO_BUCKET=e2e-skill-packages
# Docker Backend 请改用 docker/configs/backend/.env，endpoint 通常为 minio:9000。
SKILL_STORAGE_ENABLED=false
SKILL_STORAGE_REQUIRE_ADMIN=true
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_CA_CERT=
SKILL_STORAGE_READ_PREFERENCE=minio
SKILL_STORAGE_SHADOW_WRITE_BLOB=true
SKILL_STORAGE_ALLOW_LEGACY_TMP_CONFIRM=true

# ─── 本机服务地址覆盖（可选） ───
# 默认读取 backend/configs/config.yaml。只有当你的 MySQL/Redis 不在 127.0.0.1 时才填写。
# 例如：Windows Docker Desktop 暴露端口后，WSL 内 go run 可能需要填 WSL 默认网关 IP。
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DBNAME=
MYSQL_CHARSET=

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=

# 逗号分隔。默认使用 backend/configs/config.yaml 中的 cors.allow_origins。
CORS_ALLOW_ORIGINS=
