# Docker Compose interpolation variables.  This file is read by Compose from
# the docker/ directory; it is intentionally separate from
# configs/backend/.env, which is injected into application containers.

# MinIO Root credentials are used only by the minio and minio-init services.
MINIO_ROOT_USER=minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-root-secret

# Keep this value aligned with skill_storage.bucket in the Backend config.
MINIO_BUCKET=skill-packages
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
# When TLS is enabled, place the CA file under docker/certs and set this to
# /etc/agenthub/certs/<filename> (the Backend mounts docker/certs read-only).
MINIO_CA_CERT=
SKILL_STORAGE_ENABLED=false

# Avatar storage switches and non-secret connection settings used by Compose.
# The application credentials belong in docker/configs/backend/.env; minio-init
# reads that same env_file to create the least-privilege user.
AVATAR_STORAGE_WRITE_PROVIDER=minio
ASSET_MINIO_ENABLED=true
ASSET_MINIO_ENDPOINT=minio:9000
ASSET_MINIO_BUCKET=agenthub-assets
ASSET_MINIO_USE_SSL=false
ASSET_MINIO_CA_CERT=
ASSET_MINIO_REQUEST_TIMEOUT=10s

# Builtin render artifacts (private MinIO bucket; application credentials stay
# in configs/backend/.env).
ARTIFACT_STORAGE_ENABLED=false
ARTIFACT_MINIO_ENDPOINT=minio:9000
ARTIFACT_MINIO_BUCKET=agenthub-artifacts
ARTIFACT_MINIO_USE_SSL=false
ARTIFACT_MINIO_CA_CERT=
ARTIFACT_MINIO_REQUEST_TIMEOUT=15s
ARTIFACT_MAX_OBJECT_SIZE=25MiB
ARTIFACT_MAX_PER_MESSAGE=20
ARTIFACT_UPLOAD_TOKEN_TTL=30m
ARTIFACT_FAILED_RETENTION=24h

# The default MinIO writer only reads historical local avatars. Change to rw
# together with AVATAR_STORAGE_WRITE_PROVIDER=local when local uploads are used.
LOCAL_STORAGE_VOLUME_MODE=ro
