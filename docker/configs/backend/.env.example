# Docker 环境 Backend 环境变量示例
# 此文件由 Compose 以 env_file 方式在运行时注入 Backend 和 MinIO 初始化任务，
# 不会被写入镜像层。使用方法：cp docker/configs/backend/.env.example docker/configs/backend/.env
#
# Docker 环境下 backend 容器内的密钥注入；与 backend/.env 字段一致
# MinIO 启用时必须填写应用账号；不要填入 MinIO Root 凭据。
# Compose 部署时，write_provider / MinIO 开关和 endpoint 由 docker/.env 的
# 插值变量覆盖；本文件保留完整变量，供 Backend 与 minio-init 读取。

# ─── Avatar MinIO 应用凭据（独立于 Skill MinIO） ───
AVATAR_STORAGE_WRITE_PROVIDER=minio
ASSET_MINIO_ENABLED=true
ASSET_MINIO_ENDPOINT=minio:9000
ASSET_MINIO_BUCKET=agenthub-assets
ASSET_MINIO_ACCESS_KEY=
ASSET_MINIO_SECRET_KEY=
ASSET_MINIO_USE_SSL=false
ASSET_MINIO_CA_CERT=
ASSET_MINIO_REQUEST_TIMEOUT=10s
LOCAL_STORAGE_ENABLED=true
LOCAL_STORAGE_DIR=/app/uploads
LOCAL_STORAGE_URL_PREFIX=/uploads

# ─── Skill MinIO 应用凭据（仅访问 skill-packages Bucket） ───
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
