# GLM Coding Plan 额度查询配置（供 quota-query.sh 读取）
# 用法：复制为 .env 并填入真实值
#   cp .env.example .env
#
# 与 ~/.claude/.../query-usage.mjs 使用同一套环境变量。

# 平台入口：智谱用 open.bigmodel.cn，Z.ai 用 api.z.ai
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic

# 认证凭证：原值直接作为 Authorization 头，无需 Bearer 前缀
ANTHROPIC_AUTH_TOKEN=your-token-here

# Claude Code native binary 完整路径（供 run.sh 读取）
# 扩展升级后版本号会变；必须填写为可执行文件的完整路径（脚本不再自动探测）
# YOUR_USERNAME 与 VERSION 为占位符，复制到 .env 后请替换为真实值
CLAUDE_HOME=/home/YOUR_USERNAME/.vscode-server/extensions/anthropic.claude-code-VERSION-linux-x64/resources/native-binary/claude
